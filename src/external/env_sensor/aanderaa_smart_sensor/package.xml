<?xml version="1.0"?>
<package format="3">
  <name>aanderaa_smart_sensor</name>
  <version>0.2.1</version>
  <description>ROS 2 Humble serial driver for Aanderaa Smart Sensor turbidity and conductivity sensors.</description>

  <maintainer email="chrimai@energy.aau.dk">Christian Mai</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>rcl_interfaces</exec_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
