<?xml version="1.0"?>
<package format="3">
  <name>sonar_image_proc</name>
  <version>0.1.0</version>
  <description>ROS 2 Python port of the sonar_image_proc sonar_pointcloud node for ProjectedSonarImage to PointCloud2 conversion.</description>

  <maintainer email="chrimai@energy.aau.dk">Christian Mai</maintainer>
  <license>LGPL-3</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>marine_acoustic_msgs</exec_depend>
  <exec_depend>acoustic_msgs</exec_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
